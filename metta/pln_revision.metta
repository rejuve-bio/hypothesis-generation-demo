!(import! &self (library lib_spaces))
!(import! &self (library lib_patrick))
!(import! &self (library lib_pln))
!(import! &self (library lib_import))
!(import_prolog_function string_concat)
!(import_prolog_functions_from_file "./bio2/queries.pl" ())
!(import_prolog_functions_from_file "./bio2/utils.pl" (load_train_fold load_test_fold read_model_file eval_pair string_interpolate assert_all retract_all count_models))
!(import_prolog_function numlist)
!(import! &self "utils.py")

;1. PLN IMPLICATION TO CLAUSE COMPILATION EXTENSION:
(: => (-> Expression Expression Atom Atom))
(= (=> (cons , $args) $C $stvImp)
       (progn (add-atom &self (= $C (Truth_ModusPonens (foldl-atom $args (stv 1.0 1.0) Truth_ModusPonens) $stvImp)))))

(= (Truth_NoisyOr (stv $f1 $c1) (stv $f2 $c2))
   (stv (- (+ $f1 $f2) (* $f1 $f2)) (min 1.0 (max $c1 $c2))))

;2. QUERY FN
(: ? (-> Expression Atom))
(= (? $term)
   (unique-atom (collapse ($term (progn (reduce $term) ;ensures binding to specific answer, then combines evidence for all derived variants:
                                        (foldl-atom (collapse (reduce $term)) (stv 0.0 0.0) Truth_Revision))))))

(: ?noisy-or (-> Expression Atom))
(= (?noisy-or $term)
   (unique-atom (collapse ($term (progn (reduce $term)
                                        (foldl-atom (collapse (reduce $term)) (stv 0.0 0.0) Truth_NoisyOr))))))

;3. LOAD BIO-AS
(= (load-atomspace $baseDir $kbs)
    (let $dbPath (string_concat $baseDir (superpose $kbs))
         (collapse (static-import! &self $dbPath))))
!(println! "Loading Bio Atomspace ...")

!(load-atomspace "/mnt/hdd_1/biocypher-kg/output/human/prolog_out_v3/"
         ("gencode/gene/nodes" "gtex/eqtl/edges" "tadmap/nodes" "tadmap/edges"
           "refseq/edges" "abc/edges" "dbsnp/nodes" "dbsuper/nodes" "dbsuper/edges"
           "enhancer_atlas/nodes" "enhancer_atlas/edges"
           "ccre/enhancer_ccre/nodes" "ccre/promoter_ccre/nodes"
           "ccre/enhancer_ccre/edges"  "ccre/promoter_ccre/edges"
           "peregrine/nodes" "peregrine/edges"
           "pgboost/edges"))


!(println! "BioAS Loaded.")

;4. PLN lifting of premise facts such that each has truth values:
(= (associated_with_stv $enh $gene)
   (progn (translatePredicate (associated_with (Predicate (enhancer $enh)) (Predicate (gene $gene))))
          (stv 1.0 0.9)))

(= (associated_with_stv $enh $gene)
   (progn (translatePredicate (associated_with (Predicate (super_enhancer $enh)) (Predicate (gene $gene))))
          (stv 1.0 0.9)))

(= (eqtl_association_stv $snp $gene)
   (progn (translatePredicate (eqtl_association (Predicate (snp $snp)) (Predicate (gene $gene))))
          (stv 1.0 0.9)))

(= (activity_by_contact_stv $snp $gene)
   (progn (translatePredicate (activity_by_contact (Predicate (snp $snp)) (Predicate (gene $gene))))
          (stv 1.0 0.9)))

(= (pgboost_stv $snp $gene)
   (progn (translatePredicate (pgboost (Predicate (snp $snp)) (Predicate (gene $gene))))
          (stv 1.0 0.9)))

(= (within_k_distance_stv $enh $snp $dist)
   (progn (translatePredicate (within_k_distance (Predicate (super_enhancer $enh)) (Predicate (snp $snp)) $dist 1))
          (stv 1.0 0.9)))

(= (within_k_distance_stv $enh $snp $dist)
   (progn (translatePredicate (within_k_distance (Predicate (enhancer $enh)) (Predicate (snp $snp)) $dist 1))
          (stv 1.0 0.9)))

;5. PLN implications:
; Structural rules (not learned, fixed stv):
!(=> (, (within_k_distance_stv $enh $snp 50000))
     (in_regulatory_region $snp $enh) (stv 1.0 0.99))

!(=> (, (in_regulatory_region $snp $enh) (associated_with_stv $enh $gene))
     (regulatory_effect $snp $gene) (stv 1.0 0.99))

; Per-fold learned parameters (generated by run_experiment.py):
!(import! &self "fold_params.metta")

; Fold-aware relevant_gene rules (stv looked up per fold):
(= (relevant_gene $gene $snp $fold)
   (Truth_ModusPonens
     (foldl-atom ((eqtl_association_stv $snp $gene)) (stv 1.0 1.0) Truth_ModusPonens)
     (fold-stv eqtl_association $fold)))

(= (relevant_gene $gene $snp $fold)
   (Truth_ModusPonens
     (foldl-atom ((activity_by_contact_stv $snp $gene)) (stv 1.0 1.0) Truth_ModusPonens)
     (fold-stv activity_by_contact $fold)))

(= (relevant_gene $gene $snp $fold)
   (Truth_ModusPonens
     (foldl-atom ((regulatory_effect $snp $gene)) (stv 1.0 1.0) Truth_ModusPonens)
     (fold-stv regulatory_effect $fold)))

(= (relevant_gene $gene $snp $fold)
   (Truth_ModusPonens
     (foldl-atom ((pgboost_stv $snp $gene)) (stv 1.0 1.0) Truth_ModusPonens)
     (fold-stv pgboost $fold)))


;6 Querying — $fold threaded through
(= (query-stv $gene $snp $fold)
   (let $results (collapse (relevant_gene $gene $snp $fold))
        (if (== $results ())
            (stv 0.0 0.0)
            (foldl-atom $results (stv 0.0 0.0) Truth_NoisyOr))))

(= (eval-model $i $fold)
     (let* (($label (eval_pair $i (Predicate (gene $gene)) (Predicate (snp $snp))))
            ($score (query-stv $gene $snp $fold))
            ((stv $strength $conf) $score))
         ($label $strength $conf)))

(= (eval-model-exp $i $fold)
     (let* (($label (eval_pair $i (Predicate (gene $gene)) (Predicate (snp $snp))))
            ($score (query-stv $gene $snp $fold))
            ((stv $strength $conf) $score)
            ($exp (* $strength $conf)))
         ($label $exp)))

;Use strength
(= (eval-fold-strength $dir $fold)
    (let* (($test (load_test_fold $dir $fold))
            ($models (read_model_file (string_interpolate "~w/fold_~w/models.pl" ($dir $fold))))
            ($modelsRef (assert_all $models))
            ($testPred (collapse (let ($label $strength $conf) (eval-model (superpose $test) $fold) ($label $strength $conf))))
            ($auc (py-call (utils.auc $testPred 1))))

          (progn
               (translatePredicate (cleanup))
               $auc)))

;Use confidence
(= (eval-fold-conf $dir $fold)
    (let* (($test (load_test_fold $dir $fold))
            ($models (read_model_file (string_interpolate "~w/fold_~w/models.pl" ($dir $fold))))
            ($modelsRef (assert_all $models))
            ($testPred (collapse (let ($label $strength $conf) (eval-model (superpose $test) $fold) ($label $strength $conf))))
            ($auc (py-call (utils.auc $testPred 2))))

          (progn
               (translatePredicate (cleanup))
               $auc)))

;Use strength*conf
(= (eval-fold-exp $dir $fold)
    (let* (($test (load_test_fold $dir $fold))
            ($models (read_model_file (string_interpolate "~w/fold_~w/models.pl" ($dir $fold))))
            ($modelsRef (assert_all $models))
            ($testPred (collapse (let ($label $exp) (eval-model-exp (superpose $test) $fold) ($label $exp))))
            ($auc (py-call (utils.auc $testPred 1))))

          (progn
               (translatePredicate (cleanup))
               $auc)))


(= (eval-all-folds $evalFn $dir $numFolds)
     (let* (($folds (numlist 0 (- $numFolds 1)))
            ($aucs (collapse ($evalFn $dir (superpose $folds))))
            (($mean $std) (py-call (utils.mean_and_se $aucs))))

          (progn
               (println! ("AUCs: " $aucs))
               ($mean $std))))

(= (run-exps $dir $numFolds)
     (let* ((($mean_st $std_st) (eval-all-folds eval-fold-strength $dir $numFolds))
            (($mean_conf $std_conf) (eval-all-folds eval-fold-conf $dir $numFolds))
            (($mean_exp $std_exp) (eval-all-folds eval-fold-exp $dir $numFolds))
            )
          (progn
               (println! ("Strength ONLY: Mean: " $mean_st " SD: " $std_st))
               (println! ("CONF ONLY: Mean: " $mean_conf " SD: " $std_conf))
               (println! ("Expectation (s*c): Mean: " $mean_exp " SD: " $std_exp))
               )))

!(run-exps "./bio2/data/chr16" 5)
